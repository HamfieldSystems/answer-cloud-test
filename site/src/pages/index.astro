---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { PROMPT, REAL_SITE } from "../consts";

const outcomes = [
  {
    title: "Made for answer engines",
    body: "Every site gets automatic answer-engine optimization, so AI can understand what you publish.",
  },
  {
    title: "See how agents use your site",
    body: "See human visits, AI referrals and agent traffic in one dashboard, and which pages they find.",
  },
  {
    title: "A site that answers back",
    body: "Visitors ask questions. Your site's AI chat answers from your published content, with links to the source.",
  },
  {
    title: "Know what to write next",
    body: "See what AI can find on your site, where a clearer answer would help, and what people are asking.",
  },
];

const steps = [
  { title: "Copy the prompt", body: "It's one line. You'll find it above, or on answer.cloud." },
  {
    title: "Paste it into your agent",
    body: "Use Claude Code or Codex. Your agent asks for your email, your organization's name and a short description.",
  },
  {
    title: "Get a live site",
    body: "Your agent builds the site, publishes it at your answer.cloud address and turns on AI chat. Then it gives you the live link.",
  },
];

const notNeeded = [
  "An account or password. answer.cloud emails you a setup link.",
  "A credit card",
  "A repository",
  "A domain",
  "A plugin to install",
];

const faq = [
  {
    q: "What is answer.cloud?",
    a: "answer.cloud builds and hosts websites that people can use and AI can understand. Each site gets automatic answer-engine optimization, AI chat that answers from your published content, and analytics on visits from people and AI.",
  },
  {
    q: "How do I build a site on answer.cloud?",
    a: `Copy the prompt "${PROMPT}" and paste it into Claude Code or Codex. Your agent builds the site and publishes it at your answer.cloud address.`,
  },
  {
    q: "Do I need to sign up or add a card first?",
    a: "No. Your first site needs no sign-up, no credit card and no repository. answer.cloud emails you a link to finish setting up your account.",
  },
  {
    q: "What does the Free plan include?",
    a: "AI chat answers from your first 10 pages, 10 CMS pages, and your first month of visitor and AI agent analytics, on a hosted answer.cloud address.",
  },
  {
    q: "How much is Pro?",
    a: "Pro is $20 a month per site, plus additional usage. It adds ongoing analytics, site search, CMS pages beyond 10, and a custom domain.",
  },
  {
    q: "Is this page made by answer.cloud?",
    a: "No. It's an unofficial homepage concept by conversion copywriter Helen Peatfield, made for answer.cloud's founder. The real site is www.answer.cloud.",
  },
];
---

<Base
  title="answer.cloud homepage concept (unofficial) · Helen Peatfield"
  description="An unofficial homepage concept for answer.cloud by Helen Peatfield: get found in AI answers and see how AI uses your site. Not affiliated with answer.cloud."
>
  <!-- Hero: the outcome first, the prompt as the how -->
  <section class="section is-open hero">
    <div class="container">
      <span class="eyebrow">Unofficial homepage concept</span>
      <h1 class="page-title hero-title">
        Get found in AI answers.<br />
        <span class="muted-ink">See how AI uses your site.</span>
      </h1>
      <p class="lede">
        answer.cloud builds a website people can use and AI can understand. Then it shows you how
        ChatGPT and other agents find your pages, and what people ask.
      </p>

      <div class="prompt-box">
        <span class="label">One prompt for Claude Code or Codex</span>
        <div class="prompt-row">
          <code class="prompt-text" id="prompt-hero">{PROMPT}</code>
          <button type="button" class="btn btn-primary copy-btn" data-copy>
            <Icon name="copy" size={16} /> <span>Copy prompt</span>
          </button>
        </div>
      </div>

      <ul class="zero" aria-label="What you don't need">
        <li><Icon name="check" size={16} /> No sign-up</li>
        <li><Icon name="check" size={16} /> No credit card</li>
        <li><Icon name="check" size={16} /> No repo</li>
      </ul>

      <p class="mt-6">
        <a class="link-arrow" href={REAL_SITE} rel="noopener">Visit answer.cloud and try the prompt <Icon name="arrow-up-right" size={14} /></a>
      </p>
    </div>
  </section>

  <!-- Outcome -->
  <section class="section" id="outcome">
    <div class="container">
      <div class="section-head">
        <span class="section-index">01</span>
        <div>
          <span class="eyebrow">What you get</span>
          <h2 class="h1">Built to be a source AI can use</h2>
        </div>
      </div>
      <p class="lede">Your site is made for answer engines from the start, and you can see what happens next.</p>
      <div class="outcome-grid">
        {outcomes.map((o) => (
          <article class="outcome">
            <h3 class="h4">{o.title}</h3>
            <p>{o.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- How -->
  <section class="section alt" id="how">
    <div class="container">
      <div class="section-head">
        <span class="section-index">02</span>
        <div>
          <span class="eyebrow">How it works</span>
          <h2 class="h1">How do I build a site with one prompt?</h2>
        </div>
      </div>
      <p class="lede">There's nothing to set up first. Your coding agent does the building.</p>
      <ol class="feature-grid steps">
        {steps.map((s, i) => (
          <li class="feature-module">
            <div class="idx">{String(i + 1).padStart(2, "0")}</div>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>
      <div class="panel not-needed mt-8">
        <h3 class="h4">What you don't need for your first site</h3>
        <ul>
          {notNeeded.map((n) => <li><Icon name="x" size={14} /> {n}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- Plans -->
  <section class="section" id="plans">
    <div class="container">
      <div class="section-head">
        <span class="section-index">03</span>
        <div>
          <span class="eyebrow">Plans</span>
          <h2 class="h1">Start free</h2>
        </div>
      </div>
      <p class="lede">Upgrade to Pro when you need more room.</p>
      <div class="plans">
        <article class="plan">
          <h3 class="h3">Free</h3>
          <p class="price">$0<span>/month</span></p>
          <ul>
            <li><Icon name="check" size={16} /> AI chat answers from your first 10 pages</li>
            <li><Icon name="check" size={16} /> 10 CMS pages</li>
            <li><Icon name="check" size={16} /> Your first month of visitor and AI agent analytics</li>
            <li><Icon name="check" size={16} /> A hosted answer.cloud address</li>
            <li><Icon name="check" size={16} /> No credit card required</li>
          </ul>
        </article>
        <article class="plan">
          <h3 class="h3">Pro</h3>
          <p class="price">$20<span>/month per site</span></p>
          <p class="caption">plus additional usage</p>
          <ul>
            <li><Icon name="check" size={16} /> Everything in Free</li>
            <li><Icon name="check" size={16} /> Ongoing visitor and AI agent analytics</li>
            <li><Icon name="check" size={16} /> Site search, and chat beyond 10 pages</li>
            <li><Icon name="check" size={16} /> More than 10 CMS pages</li>
            <li><Icon name="check" size={16} /> A custom domain</li>
          </ul>
        </article>
      </div>
      <p class="body-sm muted mt-6">
        Full plan details, including Enterprise, are on
        <a class="link-inline" href={REAL_SITE} rel="noopener">answer.cloud</a>.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section alt" id="faq">
    <div class="container">
      <div class="section-head">
        <span class="section-index">04</span>
        <div>
          <span class="eyebrow">FAQ</span>
          <h2 class="h1">Questions people ask</h2>
        </div>
      </div>
      <div class="faq reading">
        {faq.map((f) => (
          <div class="faq-item">
            <h3 class="h4">{f.q}</h3>
            <p>{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="section is-open">
    <div class="container cta">
      <h2 class="h1">Try the prompt</h2>
      <p class="lede">Copy it and paste it into Claude Code or Codex. Your site is live at the end.</p>
      <div class="prompt-box">
        <div class="prompt-row">
          <code class="prompt-text">{PROMPT}</code>
          <button type="button" class="btn btn-primary copy-btn" data-copy>
            <Icon name="copy" size={16} /> <span>Copy prompt</span>
          </button>
        </div>
      </div>
      <p class="mt-6">
        <a class="btn btn-outline" href={REAL_SITE} rel="noopener">Visit answer.cloud <Icon name="arrow-up-right" size={14} /></a>
      </p>
    </div>
  </section>

  <!-- Notes for the founder -->
  <section class="section alt" id="notes">
    <div class="container">
      <div class="section-head">
        <span class="section-index">05</span>
        <div>
          <span class="eyebrow">For the founder</span>
          <h2 class="h1">What this concept changes</h2>
        </div>
      </div>
      <dl class="notes reading">
        <dt>Outcome first</dt>
        <dd>The page opens with what people want: being found in AI answers, and seeing how AI uses their site. The tools come later.</dd>
        <dt>The prompt is the "how"</dt>
        <dd>The one-prompt build is how you get the outcome, not the headline. The page makes clear there's nothing to set up: no sign-up, no card, no repo.</dd>
        <dt>Agent instructions off the human page</dt>
        <dd>Today the full agent instructions sit on the homepage. In this concept they move to a page only for agents, so people see the pitch and agents still get the steps.</dd>
        <dt>Only real facts</dt>
        <dd>Every feature and price here comes from answer.cloud's public homepage. There are no testimonials, stats or new claims.</dd>
      </dl>
    </div>
  </section>

  <p class="copy-status visually-hidden" role="status" aria-live="polite" id="copy-status"></p>

  <script>
    // Copy buttons. The prompt is also plain text in the markup, so the page
    // works without JavaScript.
    const status = document.getElementById("copy-status");
    document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const text = btn.parentElement?.querySelector("code")?.textContent ?? "";
        const label = btn.querySelector("span");
        try {
          await navigator.clipboard.writeText(text);
          if (label) label.textContent = "Copied";
          if (status) status.textContent = "Prompt copied. Paste it into Claude Code or Codex.";
        } catch {
          if (label) label.textContent = "Select and copy";
        }
        setTimeout(() => label && (label.textContent = "Copy prompt"), 2000);
      });
    });
  </script>
</Base>
