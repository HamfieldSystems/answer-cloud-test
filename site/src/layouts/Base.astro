---
import "../styles/tokens.css";
import "../styles/styleguide.css";
import "../styles/site.css";
import Icon from "../components/Icon.astro";
import { AUTHOR, REAL_SITE, SITE_NAME } from "../consts";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;

// Social image tags need an absolute URL on the real site origin, so they are
// only rendered when the build knows that origin (SITE_URL, see astro.config.mjs).
const origin = Astro.site;
const pageUrl = origin ? new URL(Astro.url.pathname, origin).href : undefined;
const imageUrl = origin ? new URL("/assets/social-preview.png", origin).href : undefined;
const imageAlt =
  "Unofficial answer.cloud homepage concept by Helen Peatfield: Get found in AI answers. See how AI uses your site.";

const nav = [
  { href: "#outcome", label: "What you get" },
  { href: "#how", label: "How it works" },
  { href: "#plans", label: "Plans" },
  { href: "#faq", label: "FAQ" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    {pageUrl && <meta property="og:url" content={pageUrl} />}
    {imageUrl && (
      <>
        <meta property="og:image" content={imageUrl} />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={imageAlt} />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageUrl && (
      <>
        <meta name="twitter:image" content={imageUrl} />
        <meta name="twitter:image:alt" content={imageAlt} />
      </>
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400;0,500;0,600;1,400&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a href="#main" class="visually-hidden">Skip to content</a>

    <div class="concept-bar" role="note">
      <div class="container concept-bar-inner">
        <span><strong>Unofficial concept.</strong> A homepage rewrite by {AUTHOR}. Not made by or affiliated with answer.cloud.</span>
        <a href={REAL_SITE} rel="noopener">See the real answer.cloud <Icon name="arrow-up-right" size={14} /></a>
      </div>
    </div>

    <header class="site-nav">
      <div class="site-nav-inner container">
        <a class="brand" href="#main">
          <span class="brand-name">answer.cloud</span>
          <span class="concept-tag">Concept</span>
        </a>
        <nav class="site-links" aria-label="Sections">
          {nav.map((n) => <a href={n.href}>{n.label}</a>)}
        </nav>
        <a class="btn btn-primary btn-sm" href={REAL_SITE} rel="noopener">
          Try it on answer.cloud <Icon name="arrow-up-right" size={14} />
        </a>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container site-footer-inner">
        <p class="body-sm">
          <strong>Unofficial concept</strong> by {AUTHOR}, conversion copywriter. Not made by, endorsed by
          or affiliated with answer.cloud. Features and prices are taken from answer.cloud's public homepage.
        </p>
        <a class="link-arrow" href={REAL_SITE} rel="noopener">The real answer.cloud <Icon name="arrow-up-right" size={14} /></a>
      </div>
    </footer>
  </body>
</html>
