---
import "../styles/tokens.css";
import "../styles/styleguide.css";
import "../styles/site.css";
import Icon from "../components/Icon.astro";
import { AUTHOR, LINKS, REAL_SITE, SITE_NAME, TAGLINE } from "../consts";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;

// Social image tags need an absolute URL on the real site origin, so they are
// only rendered when the build knows that origin (SITE_URL, see astro.config.mjs).
const origin = Astro.site;
const pageUrl = origin ? new URL(Astro.url.pathname, origin).href : undefined;
const imageUrl = origin ? new URL("/assets/social-preview.png", origin).href : undefined;
const imageAlt =
  "Unofficial answer.cloud homepage concept by Helen Peatfield: Be the answer, on your site and in AI tools.";

const nav = [
  { href: "#how", label: "How it works", external: false },
  { href: "#pricing", label: "Pricing", external: false },
  { href: LINKS.docs, label: "Docs", external: true },
  { href: LINKS.forAgents, label: "For agents", external: true },
  { href: LINKS.logIn, label: "Log in", external: true },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    {pageUrl && <meta property="og:url" content={pageUrl} />}
    {imageUrl && (
      <>
        <meta property="og:image" content={imageUrl} />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={imageAlt} />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageUrl && (
      <>
        <meta name="twitter:image" content={imageUrl} />
        <meta name="twitter:image:alt" content={imageAlt} />
      </>
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400;0,500;0,600;1,400&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a href="#main" class="visually-hidden">Skip to content</a>

    <div class="concept-bar" role="note">
      <div class="container concept-bar-inner">
        <span><strong>Unofficial concept.</strong> A homepage rewrite by {AUTHOR}. Not made by or affiliated with answer.cloud.</span>
        <a href={REAL_SITE} rel="noopener">See the real answer.cloud <Icon name="arrow-up-right" size={14} /></a>
      </div>
    </div>

    <header class="site-nav">
      <div class="site-nav-inner container">
        <a class="brand" href="#main">
          <span class="brand-name">answer.cloud</span>
          <span class="concept-tag">Concept</span>
        </a>
        <nav class="site-links" aria-label="Main">
          {nav.map((n) => <a href={n.href} rel={n.external ? "noopener" : undefined}>{n.label}</a>)}
        </nav>
        <a class="btn btn-primary btn-sm" href="#start">Build a site</a>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-top">
          <p class="footer-tagline"><strong>answer.cloud</strong> — {TAGLINE}.</p>
          <nav class="footer-links" aria-label="Footer">
            <a href="#how">How it works</a>
            <a href="#pricing">Pricing</a>
            <a href={LINKS.docs} rel="noopener">Docs</a>
            <a href={LINKS.blog} rel="noopener">Blog</a>
            <a href={LINKS.forAgents} rel="noopener">For agents</a>
            <a href={LINKS.bookCall} rel="noopener">Book a call</a>
          </nav>
        </div>
        <div class="footer-note">
          <p class="body-sm">
            <strong>Unofficial concept</strong> by {AUTHOR}, conversion copywriter. Not made by, endorsed by
            or affiliated with answer.cloud. Facts and prices are taken from answer.cloud's public pages;
            amber notes mark what answer.cloud still needs to supply.
          </p>
          <a class="link-arrow" href={REAL_SITE} rel="noopener">The real answer.cloud <Icon name="arrow-up-right" size={14} /></a>
        </div>
      </div>
    </footer>
  </body>
</html>
